# Copy this file to `.env` and fill in values.
# Never commit `.env` (it can contain secrets).

# -----------------------------
# Local Postgres (Docker)
# -----------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fanalyze
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Optional: dedicated ingest user (used by some scripts / Airflow)
POSTGRES_USER_INGEST=user_fanalyze_ingest
POSTGRES_PASSWORD_INGEST=fanalyze_ingest_password

# -----------------------------
# Kafka (streaming)
# -----------------------------
# For local development (host access):
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=ticket_sales
KAFKA_GROUP_ID=ticket-sales-consumer-group

# -----------------------------
# Snowflake (key-pair auth)
# -----------------------------
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_ROLE=your_role
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=FANALYZE
SNOWFLAKE_SCHEMA=FAN_RAW

# Path to your PEM-encoded private key file (NOT committed)
SNOWFLAKE_KEYPAIR_PATH=.secrets/rsa_key.p8

# Compatibility: some scripts/tests use this name
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/rsa_key.p8

# Optional: password for encrypted keys (used in CI helpers)
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=

# -----------------------------
# Batch source (Setlist.fm)
# -----------------------------
SETLISTFM_API_KEY=your_setlistfm_api_key

# -----------------------------
# RAG / LangGraph / LLM
# -----------------------------
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=fanalyze-v2-rag

# Optional: persistent LangGraph checkpointing in Postgres
LANGGRAPH_POSTGRES_HOST=localhost
LANGGRAPH_POSTGRES_PORT=5432
LANGGRAPH_POSTGRES_DB=langgraph_memory
LANGGRAPH_POSTGRES_USER=langgraph_service
LANGGRAPH_POSTGRES_PASSWORD=langgraph_service_password