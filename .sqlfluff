[sqlfluff]
dialect = snowflake
templater = dbt
exclude_rules = TMP
max_line_length = 100

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = true

[sqlfluff:rules:structure.column_order]
wildcard_policy = before

[sqlfluff:templater:dbt]
profiles_dir = .dbt
project_dir = dbt
