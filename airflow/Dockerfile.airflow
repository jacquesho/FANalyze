# Use official Apache Airflow image (3.0.6 with Python 3.12)
FROM apache/airflow:3.0.6-python3.12

# Set working directory
WORKDIR /opt/airflow

# Install system dependencies
USER root
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv (faster Python package manager)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files (pyproject.toml and uv.lock for reproducible builds)
# Copy to a temporary directory to avoid conflicts with Airflow directories
WORKDIR /tmp/build
COPY pyproject.toml uv.lock ./

# Install Python dependencies using uv pip (installs into system Python that Airflow uses)
# Install project dependencies + Airflow optional dependencies
# Using '.' installs the project and all its dependencies into system Python
# uv pip is faster and more reliable than standard pip
# Must run as root to install into system Python (/usr/local/lib/python3.12/site-packages)
RUN uv pip install --system --no-cache ".[airflow]"

# Clean up build directory
RUN rm -rf /tmp/build

# Switch back to airflow user (after installing packages as root)
USER airflow

# Add dbt to PATH (dbt gets installed via pyproject.toml dependencies)
ENV PATH="/home/airflow/.local/bin:${PATH}"

# Set working directory back
WORKDIR /opt/airflow

