    venue_utilization_pct,
    sales_velocity_per_day,
    demand_category,
    time_to_show_category,
    revenue_per_ticket,
    created_at,
    synced_at,
    CURRENT_TIMESTAMP() AS dbt_updated_at,
    CURRENT_TIMESTAMP() AS dbt_created_at
    
FROM ticket_sales_staging
  )
