  as (
    

with source_data as (
    select * from DB_T4.FAN_RAW.shows_future
),

cleaned_data as (
    select
        -- Identifiers
        show_id,
        venue_id,
        
        -- Basic info
        artist_name,
        venue_name,
        
        -- Dates
        try_cast(show_date as date) as show_date,
        try_cast(collected_at as timestamp) as collected_at,
        
        -- Location
        city_name,
        state_code,
        country_name,
        
        -- Sales data (using correct column names from CSV)
        try_cast("TICKETS_SOLD_SO_FAR" as int) as tickets_sold_so_far,
        try_cast("CURRENT_SALES_RATE" as float) as current_sales_rate,
        try_cast("DAYS_UNTIL_SHOW" as int) as days_until_show,
        try_cast("AVERAGE_TICKET_PRICE" as float) as average_ticket_price,
        "TICKET_PRICE_RANGE" as ticket_price_range,
        try_cast("CURRENT_REVENUE" as float) as current_revenue,
        
        -- Venue info
        "VENUE_TYPE" as venue_type,
        try_cast("VENUE_CAPACITY" as int) as venue_capacity,
        "ARTIST_TIER" as artist_tier,
        "MARKET_SIZE" as market_size,
        
        -- Metadata
        source
        
    from source_data
    where show_date is not null
      and artist_name is not null
      and venue_name is not null
)

select * from cleaned_data
  )
