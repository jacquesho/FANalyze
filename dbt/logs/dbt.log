-- This model reads raw JSON files from the data/external directory
-- and stores one row per JSON file with minimal processing

with json_files as (
  -- Read all JSON files from the external data directory
  select 
    $1 as raw_json,
    metadata$filename as file_name,
    metadata$file_row_number as file_row_number
  from @DB_T4.FAN_RAW.STAGE_RAW_JSON
)

select
  file_name,
  file_row_number,
  raw_json:metadata:fetched_at::string as fetched_at,
  raw_json:metadata:api_version::string as api_version,
  raw_json:metadata:total_artists::int as total_artists,
  raw_json:metadata:total_shows::int as total_shows,
  raw_json:data as artist_data,
  raw_json as raw_payload,
  current_timestamp() as ingested_at
from json_files
    )

