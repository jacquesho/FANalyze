    end as venue_size_class,
    
    -- Market performance
    case 
        when avg_attendance_rate >= 90 then 'High Performance'
        when avg_attendance_rate >= 70 then 'Good Performance'
        when avg_attendance_rate >= 50 then 'Average Performance'
