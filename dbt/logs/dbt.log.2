        venue_name,
        count(distinct show_id) as upcoming_shows
    from DB_T4.FAN_staging.stg_shows_future
    group by venue_id, venue_name
)

select 
    v.venue_id,
    v.venue_name,
    v.venue_type,
    v.venue_capacity,
    v.city_name,
