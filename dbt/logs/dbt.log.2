    a.artist_tier,
    a.total_shows,
    a.first_show_date,
    a.last_show_date,
    a.avg_attendance_rate,
    a.avg_ticket_price,
    a.total_revenue,
    a.total_tickets_sold,
    coalesce(f.upcoming_shows, 0) as upcoming_shows,
    case 
