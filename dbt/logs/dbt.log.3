    cumulative_tickets_sold,
    revenue,
    cumulative_revenue,
    venue_capacity,
    sales_rate,
    days_until_show,
    artist_tier,
    average_ticket_price,
    venue_utilization_pct,
    sales_velocity_per_day,
    created_at,
    synced_at
FROM ranked
WHERE rn = 1
    )

