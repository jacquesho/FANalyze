        END AS revenue_per_ticket
        
    FROM DB_T4.FAN_intermediate.int_ticket_sales_dedup
    
    
        -- Only process new records since last run (with safe fallback on first load)
        WHERE timestamp >= COALESCE((SELECT MAX(timestamp) FROM DB_T4.FAN_marts.fact_ticket_sales), '1970-01-01'::timestamp)
    
)

