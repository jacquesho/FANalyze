        when last_show_date >= current_date - interval '1 year' then 'Active'
        when last_show_date >= current_date - interval '2 years' then 'Recently Active'
        else 'Inactive'
    end as activity_status
    
from DB_T4.FAN_intermediate.int_artists
    )

