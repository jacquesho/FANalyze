-- File: models/03_marts/fact_ticket_sales.sql



WITH ticket_sales_staging AS (
    SELECT 
        ticket_sales_key,
        id,
        timestamp,
        show_id,
        artist_name,
        venue_name,
        show_date,
        city_name,
        state_code,
        tickets_sold,
        cumulative_tickets_sold,
        revenue,
        cumulative_revenue,
        venue_capacity,
